#!/bin/sh
# Optional local identity guard. It does not switch roles or check push readiness.
# Install only after reviewing the hook guide and any existing pre-commit hook.
if command -v gitrole >/dev/null 2>&1; then
  # The wrapper owns bypass guidance even when the CLI cannot start.
  GITROLE_COMMIT_HOOK=1 gitrole check commit
  result=$?
else
  printf '%s\n' 'gitrole pre-commit: gitrole is unavailable on the hook PATH.' >&2
  result=1
fi
case "$result" in
  0) exit 0 ;;
  1|2) ;;
  *) printf '%s\n' 'gitrole pre-commit: the commit check could not run successfully.' >&2; result=1 ;;
esac
printf '%s\n' 'gitrole pre-commit: commit check failed; review the error above and ensure the hook PATH has a gitrole version supporting check commit.' >&2
printf '%s\n' 'git commit --no-verify bypasses this pre-commit hook and all other pre-commit checks (and commit-msg). It does not correct identity. Use it only if you deliberately accept that bypass.' >&2
exit "$result"
