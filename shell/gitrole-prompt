#!/bin/sh
# Print a prompt segment from one `gitrole status --short --offline` line.
#
#   gitrole:<role> ✓   commit and policy are ok, remote is not warn, auth=na
#   gitrole:<role> ⚠   a local field is warn, overall=warning, or auth=ok
#   gitrole:? ⚠        status failed, or role/fields could not be read
#
# ✓ means commit and policy are ok and auth was not checked. It does not mean
# network auth was verified. auth=na is a skipped SSH probe, not a green auth
# check. There is no cache.
#
# status --short --offline does not emit auth=ok. A line that still says
# auth=ok is unexpected. The formatter prints gitrole:<role> ⚠ for it.
#
# Role tokens use validateRoleName in src/domain/role.ts (^[a-z0-9_-]+$).
# The case pattern below is that rule in POSIX sh.
#
#   gitrole-prompt --format    parse one short line from stdin
#   gitrole-prompt             inside a git repo, run status --short --offline once
#
# Contract: examples/prompt/README.md
# Docs: docs/guides/show-gitrole-in-your-shell-prompt.md

set -u
set -f

usage() {
  printf '%s\n' 'usage: gitrole-prompt [--format]'
}

format_segment() {
  _line=$1
  _role=
  _commit=
  _remote=
  _auth=
  _policy=
  _overall=

  case $_line in
    *'
'*)
      printf '%s\n' 'gitrole:? ⚠'
      return
      ;;
  esac

  if [ -z "$_line" ]; then
    printf '%s\n' 'gitrole:? ⚠'
    return
  fi

  for _field in $_line; do
    _key=${_field%%=*}
    _value=${_field#*=}
    case $_key in
      role) _role=$_value ;;
      commit) _commit=$_value ;;
      remote) _remote=$_value ;;
      auth) _auth=$_value ;;
      policy) _policy=$_value ;;
      overall) _overall=$_value ;;
    esac
  done

  # validateRoleName: src/domain/role.ts
  case $_role in
    ''|*[!a-z0-9_-]*)
      printf '%s\n' 'gitrole:? ⚠'
      return
      ;;
  esac

  if [ -z "$_commit" ] || [ -z "$_remote" ] || [ -z "$_auth" ] || [ -z "$_policy" ] || [ -z "$_overall" ]; then
    printf '%s\n' 'gitrole:? ⚠'
    return
  fi

  _policy_ok=0
  _remote_ok=0
  case $_policy in
    ok|na) _policy_ok=1 ;;
  esac
  case $_remote in
    ok|na) _remote_ok=1 ;;
  esac

  if [ "$_commit" = ok ] &&
    [ "$_policy_ok" -eq 1 ] &&
    [ "$_remote_ok" -eq 1 ] &&
    [ "$_auth" = na ] &&
    [ "$_overall" = aligned ]; then
    printf 'gitrole:%s ✓\n' "$_role"
    return
  fi

  printf 'gitrole:%s ⚠\n' "$_role"
}

discover_git() {
  _dir=$PWD

  while :; do
    if [ -e "$_dir/.git" ]; then
      return 0
    fi

    if [ "$_dir" = / ]; then
      return 1
    fi

    _dir=$(dirname "$_dir")
  done
}

run_offline_status() {
  if ! command -v gitrole >/dev/null 2>&1; then
    printf '%s\n' 'gitrole:? ⚠'
    return
  fi

  _line=$(gitrole status --short --offline 2>/dev/null)
  _status=$?

  if [ "$_status" -ne 0 ] && [ "$_status" -ne 2 ]; then
    printf '%s\n' 'gitrole:? ⚠'
    return
  fi

  format_segment "$_line"
}

case ${1:-} in
  '') ;;
  --format)
    IFS= read -r line || line=
    format_segment "$line"
    exit 0
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if ! discover_git; then
  exit 0
fi

run_offline_status
